# Discord
DISCORD_BOT_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_discord_app_id
DISCORD_CHANNEL_ID=fallback_channel_id

# GitHub App (single app handles both OAuth and webhook events)
GITHUB_APP_NAME=TakoyakiBot
GITHUB_CLIENT_ID=your_github_app_client_id
GITHUB_CLIENT_SECRET=your_github_app_client_secret
GITHUB_WEBHOOK_SECRET=your_webhook_secret_string

# GitHub App API access (used by /request-review to list org repos and open PRs)
# App ID is shown on the GitHub App settings page.
GITHUB_APP_ID=123456
# Private key generated under "Private keys". Escaped newlines (\n) are supported,
# as is a base64-encoded PEM.
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Server
# Public URL of this deployment. It must match the GitHub App settings:
#   OAuth callback URL: {BASE_URL}/auth/callback
#   Setup URL:          {BASE_URL}/auth/setup
#   Webhook URL:        {BASE_URL}/webhook
BASE_URL=https://your-app.example.com
# Set to your local path for development, /data/data.json on Render
DATA_PATH=./data/data.json
